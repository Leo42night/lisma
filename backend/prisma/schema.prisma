generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "sqlite"
}

// konten disimpan sebagai string JSON berisi array ContentBlock
// (lihat src/types.ts untuk bentuk tiap elemen: paragraf, subheading,
// gambar, kutipan, eventData)
model Article {
  id        String   @id @default(uuid())
  judul     String
  ringkasan String
  kategori  String
  penulis   String
  tanggal   DateTime
  waktuBaca Int
  konten    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
